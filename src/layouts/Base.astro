---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { url, otazky } from '../lib/data.js';
import LogoDfk from '../components/LogoDfk.astro';

const {
  title,
  description = 'Interaktivní příprava na profilovou maturitu z Dějin výtvarné kultury: 30 otázek, časová osa, kartičky, kvízy a režim zkoušení.',
  ogImage = '/img/q01-og.jpg',
  epocha = 'pravek-starovek',
  bodyClass = '',
} = Astro.props;
const fullTitle = title ? `${title} · Dějiny výtvarné kultury` : 'Dějiny výtvarné kultury';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(url(ogImage), Astro.site);
---
<!doctype html>
<html lang="cs" data-epocha={epocha}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F4EFE6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120F" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Dějiny výtvarné kultury" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Dějiny umění" />
    <script is:inline>
      // motiv a režim projektoru ještě před vykreslením (bez probliknutí)
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('dvk-motiv');
        if (t) document.documentElement.dataset.theme = t;
        if (location.search.includes('projektor')) localStorage.setItem('dvk-projektor', '1');
        if (localStorage.getItem('dvk-projektor') === '1') document.documentElement.dataset.projektor = '';
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <header class="topbar">
      <div class="brand">
        <a class="dfk-badge" href="https://dfkstudio.cz" target="_blank" rel="noopener" aria-label="DFK Studio – dfkstudio.cz (otevře se v novém okně)">
          <LogoDfk variant="mark" />
        </a>
        <a class="brand-home" href={url('/')} aria-label="Dějiny výtvarné kultury – úvodní stránka">
          <span class="brand-text">Dějiny výtvarné kultury</span>
          <span class="brand-short" aria-hidden="true">Dějiny umění</span>
        </a>
      </div>
      <nav class="topnav" aria-label="Hlavní navigace">
        <a href={url('/#osa')}>Osa</a>
        <a href={url('/prehled/')}>Přehled</a>
        <a href={url('/karticky/')}>Kartičky</a>
        <a href={url('/zkouseni/')}>Zkoušení</a>
      </nav>
      <div class="topbar-tools">
        <span class="hotovo" data-hotovo title="Otázky označené jako Umím">
          <span class="hotovo-bar"><span></span></span>
          <span class="hotovo-text">0/{otazky.length}</span>
        </span>
        <button class="icon-btn hide-sm" data-toggle-projektor aria-label="Režim projektoru (klávesa P)" title="Režim projektoru (P)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="11" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 16v4M8 20h8" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        <button class="icon-btn" data-toggle-theme aria-label="Přepnout světlý / tmavý režim">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
      </div>
    </header>
    <main id="obsah">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <p class="eyebrow">Profilová maturita · Dějiny výtvarné kultury · 2026/27</p>
        <p>Text je zpracovaný z obecných znalostí dějin umění; u přesných dat doporučujeme kontrolu v učebnici.</p>
        <p class="footer-keys"><kbd>←</kbd> <kbd>→</kbd> předchozí / další otázka · <kbd>P</kbd> režim projektoru</p>
      </div>
      <a class="credit" href="https://dfkstudio.cz" target="_blank" rel="noopener">
        <span class="credit-inner">
          <LogoDfk variant="full" class="credit-logo" />
          <span class="credit-text"><span class="credit-line">Tento web vytvořilo <b>DFK STUDIO</b>.</span><span class="credit-url">dfkstudio.cz ↗</span></span>
        </span>
      </a>
    </footer>
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
